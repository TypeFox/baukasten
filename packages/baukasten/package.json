{
    "name": "baukasten-ui",
    "version": "0.3.0",
    "description": "A UI toolkit for Web, Eclipse Theia and VSCode",
    "homepage": "https://typefox.dev/baukasten",
    "keywords": [
        "baukasten-ui",
        "ui",
        "toolkit",
        "vscode",
        "Theia",
        "react",
        "components"
    ],
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./core": {
            "types": "./dist/core.d.ts",
            "import": "./dist/core.mjs",
            "require": "./dist/core.cjs"
        },
        "./extra": {
            "types": "./dist/extra.d.ts",
            "import": "./dist/extra.mjs",
            "require": "./dist/extra.cjs"
        },
        "./data-table": {
            "types": "./dist/data-table.d.ts",
            "import": "./dist/data-table.mjs",
            "require": "./dist/data-table.cjs"
        },
        "./dist/baukasten-base.css": "./dist/baukasten-base.css",
        "./dist/baukasten-vscode.css": "./dist/baukasten-vscode.css",
        "./dist/baukasten-theia.css": "./dist/baukasten-theia.css",
        "./dist/baukasten-web.css": "./dist/baukasten-web.css"
    },
    "files": [
        "dist",
        "src"
    ],
    "sideEffects": false,
    "scripts": {
        "dev": "vite",
        "build": "tsc --project tsconfig.build.json && vite build && npm run build:css",
        "prepare:next": "npm --workspaces-update false --no-git-tag-version version \"$(semver $npm_package_version)-next.$(git rev-parse --short HEAD)\"",
        "build:css": "npx tsx scripts/generate-css.ts",
        "preview": "vite preview",
        "watch": "vite build --watch --mode development",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
        "test": "vitest run",
        "test:ui": "vitest --ui",
        "test:watch": "vitest --watch",
        "test:coverage": "vitest --coverage"
    },
    "peerDependencies": {
        "@tanstack/react-table": "^8.21.3",
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    },
    "peerDependenciesMeta": {
        "@tanstack/react-table": {
            "optional": true
        }
    },
    "dependencies": {
        "@floating-ui/react": "^0.27.20",
        "@vscode/codicons": "^0.0.45",
        "clsx": "^2.1.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@microsoft/api-extractor": "^7.60.2",
        "@storybook/addon-docs": "^10.6.9",
        "@storybook/addon-links": "^10.6.9",
        "@storybook/react-vite": "^10.6.9",
        "@tanstack/react-table": "^8.21.3",
        "@tanstack/react-virtual": "^3.14.28",
        "@testing-library/jest-dom": "^8.0.0",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.13",
        "@types/react": "^19.3.3",
        "@types/react-dom": "^19.3.0",
        "@vanilla-extract/css": "^1.21.3",
        "@vanilla-extract/recipes": "^0.5.7",
        "@vanilla-extract/vite-plugin": "^5.2.6",
        "@vitejs/plugin-react": "^6.3.0",
        "@vitest/coverage-v8": "^5.1.2",
        "baukasten-ui-web-wrapper": "*",
        "eslint": "^10.16.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-storybook": "^10.6.9",
        "globals": "^17.14.0",
        "jsdom": "^31.0.1",
        "react": "^18.0.0 || ^19.0.0",
        "react-docgen": "^8.0.4",
        "react-dom": "^18.0.0 || ^19.0.0",
        "storybook": "^10.6.9",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.74.0",
        "unplugin-dts": "^1.1.2",
        "vite": "^8.4.0",
        "vitest": "^5.1.2"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/typefox/baukasten.git",
        "directory": "packages/baukasten"
    },
    "bugs": "https://github.com/typefox/baukasten/issues",
    "author": {
        "name": "TypeFox",
        "url": "https://www.typefox.io"
    }
}
